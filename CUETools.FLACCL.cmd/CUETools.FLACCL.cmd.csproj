<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net47</TargetFramework>
    <ProjectGuid>{1FCA8834-34E6-47CF-B53F-D8DF35345363}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>CUETools.FLACCL.cmd</RootNamespace>
    <AssemblyName>CUETools.FLACCL.cmd</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CUEToolsDisableCoreResxExtension>true</CUEToolsDisableCoreResxExtension>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <!-- Preserve the legacy AnyCPU executable's 32BITPREFERRED launch contract.
         The FLACCL/OpenCL path fails with OUT_OF_RESOURCES in a 64-bit host on
         the qualified NVIDIA driver, while the historical 32-bit host passes. -->
    <Prefer32Bit>true</Prefer32Bit>
    <OutputPath>..\bin\$(Configuration)\net47\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CUETools.Codecs.Flake\CUETools.Codecs.Flake.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\CUETools.Codecs\CUETools.Codecs.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\CUETools.Codecs.FLACCL\CUETools.Codecs.FLACCL.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\ThirdParty\openclnet\source\OpenCLNet.csproj" />
  </ItemGroup>

</Project>
