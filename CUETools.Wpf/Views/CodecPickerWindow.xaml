<Window x:Class="CUETools.Wpf.Views.CodecPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose output codec"
        Width="980" Height="680" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource Ink}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Choose output codec" FontFamily="{StaticResource Serif}"
                   FontSize="25" Foreground="{DynamicResource Ink}"/>
        <TextBlock Text="Pick a format and its concrete encoder. Unavailable codecs stay visible so setup requirements are explicit."
                   Margin="0,3,18,0" Foreground="{DynamicResource Muted}"
                   TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
        <TextBlock Text="Sort" Foreground="{DynamicResource Muted}"
                   VerticalAlignment="Center" Margin="0,0,7,0"/>
        <ComboBox Width="180" ItemsSource="{Binding SortModes}"
                  SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                  Margin="0,0,14,0"/>
        <CheckBox Content="Show unavailable" IsChecked="{Binding ShowUnavailable}"
                  Foreground="{DynamicResource InkDim}" VerticalAlignment="Center"/>
      </WrapPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="430"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="2*" MinWidth="230"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource Panel}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="10" Padding="1">
        <ListView x:Name="CodecList" ItemsSource="{Binding ChoicesView}"
                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                  Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}"
                  BorderThickness="0" MouseDoubleClick="CodecList_MouseDoubleClick"
                  AutomationProperties.Name="Output codecs">
          <ListView.Resources>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="2"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding CanSelect}" Value="False">
                  <Setter Property="Opacity" Value="0.58"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Face}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource Teal}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListView.Resources>
          <ListView.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Bar}" Padding="10,7"
                          BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}"/>
                  </Border>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListView.GroupStyle>
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Codec" Width="200">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding FormatName}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Ink}"/>
                      <TextBlock Text="{Binding Implementation}" FontSize="10.5"
                                 Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Extension" DisplayMemberBinding="{Binding ExtensionLabel}" Width="82"/>
              <GridViewColumn Header="Origin" DisplayMemberBinding="{Binding Origin}" Width="130"/>
              <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="120"/>
            </GridView>
          </ListView.View>
        </ListView>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource Panel}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="10" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding SelectedChoice}">
            <TextBlock Text="{Binding CompactLabel}" FontFamily="{StaticResource Serif}"
                       FontSize="22" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Implementation}" Margin="0,3,0,0"
                       Foreground="{DynamicResource InkDim}"/>
            <Border Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}"
                    BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Teal}"/>
                <TextBlock Text="{Binding HealthDetail}" Margin="0,3,0,0"
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <TextBlock Text="What it is" Margin="0,16,0,4" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource InkDim}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="History" Margin="0,14,0,4" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding History}" Foreground="{DynamicResource InkDim}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Best use" Margin="0,14,0,4" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding BestUse}" Foreground="{DynamicResource InkDim}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Availability and licensing" Margin="0,14,0,4"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Distribution}" Foreground="{DynamicResource InkDim}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 Text="Compression and perceptual-efficiency orders are guidance, not universal benchmarks. Results depend on signal, mode, and encoder version."
                 Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                 Margin="0,0,18,0" VerticalAlignment="Center"/>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" IsCancel="True"/>
        <Button Content="Use selected" Padding="16,6" Style="{StaticResource Accent}"
                IsDefault="True" IsEnabled="{Binding SelectedChoice.CanSelect}"
                Click="UseSelected_Click"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>
