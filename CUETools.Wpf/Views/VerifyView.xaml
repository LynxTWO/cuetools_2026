<UserControl x:Class="CUETools.Wpf.Views.VerifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CUETools.Wpf.Controls"
             x:Name="VerifyPage"
             AllowDrop="True"
             PreviewDragOver="Verify_DragOver"
             Drop="Verify_Drop">
  <Grid Background="{DynamicResource Ground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Source selection remains reachable at compact widths. -->
    <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <ScrollViewer x:Name="VerifySourceScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch">
        <Grid x:Name="VerifySourceGrid" MinWidth="720" Margin="16,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Source" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Border Grid.Column="1" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
            <TextBlock Text="{Binding SourcePath}" ToolTip="{Binding SourcePath}" Foreground="{DynamicResource InkDim}" FontFamily="{StaticResource Mono}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
          </Border>
          <WrapPanel Grid.Column="2" Margin="8,0,0,0">
            <Button Content="File..." Command="{Binding BrowseFileCommand}" Padding="12,7" Margin="0,0,7,0" AutomationProperties.Name="Choose CUE sheet, playlist, or audio file"/>
            <Button Content="Folder..." Command="{Binding BrowseFolderCommand}" Padding="12,7" Margin="0,0,7,0" AutomationProperties.Name="Choose album folder"/>
            <Button Content="Verify album" Command="{Binding VerifyCommand}" Style="{StaticResource Accent}" Padding="16,7" Margin="0,0,7,0"/>
            <Button Content="Stop after disc" Command="{Binding StopCommand}" Padding="13,7"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
          </WrapPanel>
        </Grid>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="1">
      <!-- Empty state doubles as a large, keyboard-independent drop target. -->
      <Border x:Name="VerifyDropTarget" Margin="28" MaxWidth="680" MinHeight="330"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderThickness="1" CornerRadius="18"
              AutomationProperties.Name="Drop an album folder, CUE sheet, playlist, or lossless audio file"
              Visibility="{Binding HasSource, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Glass}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassLine}"/>
            <Setter Property="Opacity" Value="0.88"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource StatusAccent}"/>
                <Setter Property="Opacity" Value="1"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Margin="42" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
          <Grid Width="112" Height="112" Margin="0,0,0,18">
            <Ellipse Fill="{DynamicResource Face}" Stroke="{DynamicResource StatusAccent}" StrokeThickness="2" Opacity="0.9">
              <Ellipse.Effect><DropShadowEffect Color="#34CFC0" BlurRadius="24" ShadowDepth="0" Opacity="0.34"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="62" Height="62" Fill="{DynamicResource Ground}" Stroke="{DynamicResource GlassLine}" StrokeThickness="1"/>
            <Ellipse Width="20" Height="20" Fill="{DynamicResource StatusAccent}"/>
            <Path Data="M0,0 L0,28 M-10,18 L0,28 L10,18" Stroke="{DynamicResource Ink}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,46,0,0"/>
          </Grid>
          <TextBlock Text="Drop an album folder here" FontFamily="{StaticResource Serif}" FontSize="25" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center"/>
          <TextBlock Text="CUETools finds CUE sheets, keeps multi-disc boundaries explicit, and verifies each disc in order. You can also drop CUE, M3U, or a single supported lossless file."
                     TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,9,0,0"/>
          <TextBlock Text="Sources overlap? CUETools stops and asks instead of guessing."
                     TextAlignment="Center" Foreground="{DynamicResource StatusWarning}" FontFamily="{StaticResource Mono}" FontSize="10.5" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>

      <!-- Album workspace. Horizontal fallback prevents clipping below the supported width. -->
      <ScrollViewer x:Name="VerifyWorkScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{Binding HasSource, Converter={StaticResource BoolVis}}">
        <StackPanel MinWidth="720" Margin="24,20,24,28">
          <TextBlock Text="{Binding AlbumHeading}" ToolTip="{Binding AlbumHeading}" FontFamily="{StaticResource Serif}" FontSize="27"
                     Foreground="{DynamicResource Ink}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>

          <!-- Album-level verdict and stable physical facts. -->
          <Border Margin="0,16,0,0" Background="{DynamicResource Face}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="13" Padding="18,15">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock Text="ALBUM VERDICT" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                <TextBlock Text="{Binding OverviewHeadline}" FontFamily="{StaticResource Serif}" FontSize="21" Foreground="{DynamicResource Ink}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding OverviewDetail}" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Border Background="{DynamicResource Glass}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="13,9" Margin="4">
                  <StackPanel><TextBlock Text="DISCS" FontSize="8.5" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding DiscCountText}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource StatusAccent}"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource Glass}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="13,9" Margin="4">
                  <StackPanel><TextBlock Text="TRACKS" FontSize="8.5" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding TrackCountText}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Ink}"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource Glass}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="13,9" Margin="4">
                  <StackPanel><TextBlock Text="DURATION" FontSize="8.5" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding DurationText}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Ink}"/></StackPanel>
                </Border>
              </WrapPanel>
            </Grid>
          </Border>

          <ItemsControl x:Name="VerificationDiscList" ItemsSource="{Binding Discs}" Margin="0,9,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="13" Padding="18,16" Margin="0,9,0,0">
                  <StackPanel>
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding OutcomeText}" HorizontalAlignment="Right" FontFamily="{StaticResource Mono}" FontSize="10.5" FontWeight="Bold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding DatabaseConfirmed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusGood}"/></DataTrigger>
                                <DataTrigger Binding="{Binding CanRepair}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusWarning}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Failed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusDanger}"/></DataTrigger>
                                <DataTrigger Binding="{Binding RepairApplied}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusGood}"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Repair this disc" Margin="0,8,0,0" Padding="13,7"
                                Command="{Binding DataContext.RepairDiscCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanRepair, Converter={StaticResource BoolVis}}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding AlbumText}" FontFamily="{StaticResource Serif}" FontSize="20" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DiscIdentity}" Foreground="{DynamicResource InkDim}" FontSize="12" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding SourceCaption}" ToolTip="{Binding Source.Path}" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DockPanel>

                    <WrapPanel Margin="-5,13,-5,0">
                      <Border Width="250" MinHeight="68" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="9" Padding="14,11" Margin="5">
                        <StackPanel><TextBlock Text="ACCURATERIP" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding ArText}" FontFamily="{StaticResource Serif}" FontSize="16" Foreground="{DynamicResource StatusAccent}" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
                      </Border>
                      <Border Width="250" MinHeight="68" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="9" Padding="14,11" Margin="5">
                        <StackPanel><TextBlock Text="CUETOOLS DB" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding CtdbText}" FontFamily="{StaticResource Serif}" FontSize="16" Foreground="{DynamicResource StatusAccent}" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
                      </Border>
                      <Border Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="9" Padding="14,11" Margin="5">
                        <StackPanel><TextBlock Text="LAYOUT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding TrackCountText}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Ink}"/><TextBlock Text="{Binding DurationText}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource InkDim}"/></StackPanel>
                      </Border>
                    </WrapPanel>

                    <!-- Release facts appear only when the source actually carries them. -->
                    <WrapPanel Margin="-5,4,-5,0">
                      <Border Background="{DynamicResource Face}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="5" Visibility="{Binding HasRelease, Converter={StaticResource BoolVis}}">
                        <StackPanel><TextBlock Text="RELEASE" FontSize="8.5" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding ReleaseText}" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{DynamicResource Ink}"/></StackPanel>
                      </Border>
                      <Border Background="{DynamicResource Face}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="5" Visibility="{Binding HasLabel, Converter={StaticResource BoolVis}}">
                        <StackPanel><TextBlock Text="LABEL / CATALOG" FontSize="8.5" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding LabelText}" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{DynamicResource Ink}"/></StackPanel>
                      </Border>
                      <Border Background="{DynamicResource Face}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="5" Visibility="{Binding HasGenre, Converter={StaticResource BoolVis}}">
                        <StackPanel><TextBlock Text="GENRE" FontSize="8.5" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding GenreText}" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{DynamicResource Ink}"/></StackPanel>
                      </Border>
                      <Border Background="{DynamicResource Face}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="5" Visibility="{Binding HasBarcode, Converter={StaticResource BoolVis}}">
                        <StackPanel><TextBlock Text="BARCODE" FontSize="8.5" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding BarcodeText}" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{DynamicResource Ink}"/></StackPanel>
                      </Border>
                    </WrapPanel>

                    <Border Margin="0,12,0,0" Background="{DynamicResource Face}" BorderBrush="{DynamicResource StatusWarning}" BorderThickness="1" CornerRadius="9" Padding="14,12"
                            Visibility="{Binding ShowRepairDetail, Converter={StaticResource BoolVis}}">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                          <StackPanel DockPanel.Dock="Left"><TextBlock Text="CTDB PARITY REPAIR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding RepairSummary}" Foreground="{DynamicResource Ink}"/><TextBlock Text="{Binding RepairHeadroom}" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{DynamicResource StatusWarning}"/></StackPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding RepairRanges}" ToolTip="{Binding RepairRanges}" FontFamily="{StaticResource Mono}" FontSize="9.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                        </DockPanel>
                        <ctl:RepairScope Height="128" Active="{Binding IsBusy}" Applied="{Binding RepairApplied}" Recoverable="{Binding CanRepair}"
                                         Progress="{Binding DataContext.Progress, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                         Samples="{Binding Result.RepairSamples}" Sectors="{Binding Result.RepairSectors}" Npar="{Binding Result.RepairNpar}" MapSource="{Binding Result.RepairSectorMap}"/>
                        <TextBlock Text="{Binding RepairOutput}" ToolTip="{Binding RepairOutput}" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{DynamicResource StatusGood}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" Visibility="{Binding HasRepairOutput, Converter={StaticResource BoolVis}}"/>
                      </StackPanel>
                    </Border>

                    <Expander Header="{Binding TrackEvidenceHeader}" IsExpanded="{Binding IsExpanded}" Margin="0,13,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                      <ListView ItemsSource="{Binding Tracks}" MaxHeight="310" Background="{DynamicResource Glass}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Margin="0,7,0,0">
                        <ListView.ItemContainerStyle>
                          <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Confirmed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusGood}"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                          <GridView>
                            <GridViewColumn Header="#" Width="38" DisplayMemberBinding="{Binding Number}"/>
                            <GridViewColumn Header="Title" Width="290" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Artist" Width="180" DisplayMemberBinding="{Binding Artist}"/>
                            <GridViewColumn Header="CRC32" Width="90" DisplayMemberBinding="{Binding Crc32}"/>
                            <GridViewColumn Header="AR conf" Width="72" DisplayMemberBinding="{Binding ArText}"/>
                            <GridViewColumn Header="CTDB conf" Width="78" DisplayMemberBinding="{Binding CtdbText}"/>
                          </GridView>
                        </ListView.View>
                      </ListView>
                    </Expander>

                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="1" Text="{Binding TocText}" ToolTip="{Binding TocText}" FontFamily="{StaticResource Mono}" FontSize="9.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="230" Margin="12,0,0,0" Visibility="{Binding HasToc, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel>
        <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" Foreground="{DynamicResource InkDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <ProgressBar Height="4" Margin="0,7,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                     Background="{DynamicResource Glass}" Foreground="{DynamicResource StatusAccent}" BorderThickness="0"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
