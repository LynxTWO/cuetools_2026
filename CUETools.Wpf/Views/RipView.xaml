<UserControl x:Class="CUETools.Wpf.Views.RipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CUETools.Wpf.Controls">
  <Grid Background="{DynamicResource Ground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- drive / disc bar -->
    <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
      <ScrollViewer x:Name="DiscCommandScroller"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
      <Grid x:Name="DiscCommandGrid" MinWidth="860"
            Width="{Binding ActualWidth, ElementName=DiscCommandScroller}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Drive" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox Grid.Column="1" Width="80" VerticalAlignment="Center"
                  ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                  IsEnabled="{Binding DriveSelectorEnabled}"
                  ToolTip="Choose the drive for this window. While a read is active, choosing another drive opens an isolated CUETools window and leaves this job here."/>
        <!-- real drive model, read from INQUIRY (no disc needed) -->
        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                   Text="{Binding DriveModel}" ToolTip="{Binding DriveModel}"
                   Foreground="{DynamicResource Ink}" FontSize="12" FontWeight="SemiBold"
                   MaxWidth="190" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center"
                   Text="{Binding DiscInfoText}" ToolTip="{Binding DiscInfoText}"
                   Foreground="{DynamicResource InkDim}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                   MaxWidth="230" TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="6" Content="{Binding EjectButtonText}" Command="{Binding EjectCommand}" Padding="12,6" Margin="8,0,0,0" VerticalAlignment="Center"
                ToolTip="{Binding EjectButtonTip}"/>
        <Button Grid.Column="5" Content="Read disc" Command="{Binding ReadDiscCommand}" Padding="12,6" VerticalAlignment="Center"/>
        <!-- release picker: ranked best-first by source + completeness; pick one to relabel -->
        <ComboBox Grid.Column="4" MinWidth="180" MaxWidth="320" Margin="10,0,10,0"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"
                  Visibility="{Binding HasReleases, Converter={StaticResource BoolVis}}"
                  ToolTip="Metadata release used for this rip. Ranked best-first by source quality and how complete the info is. Pick one to relabel the album and tracks.">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <DockPanel MinWidth="264" ToolTip="{Binding Why}">
                <Border DockPanel.Dock="Right" Background="{StaticResource Teal}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsBest, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="BEST" FontSize="8" FontWeight="Bold" Foreground="#04110F"/>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Source}" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Ink}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </DockPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
      </ScrollViewer>
    </Border>

    <!-- disc present: metadata + tracks + action bar -->
    <ScrollViewer x:Name="DiscWorkScroller" Grid.Row="1"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  Visibility="{Binding ShowDiscArea, Converter={StaticResource BoolVis}}">
    <Grid MinWidth="860" Width="{Binding ActualWidth, ElementName=DiscWorkScroller}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.35*" MinWidth="180" MaxWidth="252"/>
        <ColumnDefinition Width="*" MinWidth="500"/>
        <ColumnDefinition Width="0.32*" MinWidth="180" MaxWidth="234"/>
      </Grid.ColumnDefinitions>

      <!-- right: AccurateRip / CTDB / options -->
      <Border Grid.Column="2" Grid.RowSpan="3" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="14,16">
        <ScrollViewer x:Name="RipRightRailScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,11">
            <StackPanel>
              <TextBlock Text="ACCURATERIP" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,7"/>
              <TextBlock Text="{Binding ArText}" FontFamily="{StaticResource Mono}" FontSize="15" Foreground="{StaticResource Good}"/>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,11">
            <StackPanel>
              <TextBlock Text="CTDB" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,7"/>
              <TextBlock Text="{Binding CtdbText}" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Good}"/>
            </StackPanel>
          </Border>
          <!-- verify-history verdict: a second, offline, AccurateRip-independent bit-exactness check
               against this app's own earlier reads of the same disc. Shown after either a rip or a
               verify (HistoryText is set in both paths); hidden until there is a result. -->
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,11">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HistoryText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="VERIFY HISTORY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,7"/>
              <TextBlock Text="{Binding HistoryText}" FontSize="12" TextWrapping="Wrap"
                         Foreground="{Binding HistoryIsWarning, Converter={StaticResource BoolBrush}, ConverterParameter=Amber;Muted}"/>
            </StackPanel>
          </Border>
          <!-- Test & Copy HELD: two reads disagreed on one or more tracks. Nothing is written to the
               output folder until the user re-runs, accepts the copy read anyway (flagged not test-
               verified), or discards the staged reads. -->
          <Border Visibility="{Binding TestCopyHeld, Converter={StaticResource BoolVis}}"
                  Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,11">
            <StackPanel>
              <TextBlock Text="TEST &amp; COPY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,7"/>
              <TextBlock Text="{Binding TestCopyText}" FontSize="12" TextWrapping="Wrap"
                         Foreground="{Binding TestCopyIsWarning, Converter={StaticResource BoolBrush}, ConverterParameter=Amber;Muted}"/>
              <WrapPanel Margin="0,10,0,0">
                <Button Content="Re-run" Command="{Binding TestCopyCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Accept anyway" Command="{Binding AcceptCopyAnywayCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Discard" Command="{Binding DiscardHeldCommand}" Padding="12,6"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Padding="13">
            <StackPanel>
              <TextBlock Text="OPTIONS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
              <DockPanel Margin="0,3,0,0">
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CreateCue}"/>
                <TextBlock Text="Create .cue sheet" ToolTip="Create .cue sheet"
                           Foreground="{DynamicResource InkDim}" FontSize="12.5"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <DockPanel Margin="0,8,0,0">
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding WriteLog}"/>
                <TextBlock Text="Write rip log" ToolTip="Write rip log"
                           Foreground="{DynamicResource InkDim}" FontSize="12.5"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <DockPanel Margin="0,8,0,0">
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding EmbedArt}"/>
                <TextBlock Text="Embed cover art" ToolTip="Embed cover art"
                           Foreground="{DynamicResource InkDim}" FontSize="12.5"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <!-- The preview is also the accessible entrypoint to the release-bound candidate
                   browser. The selected master is frozen and resized before a job starts. -->
              <StackPanel Margin="0,10,0,0" Visibility="{Binding ArtEnabled, Converter={StaticResource BoolVis}}">
                <Button Width="142" MinHeight="42" HorizontalAlignment="Left"
                        Padding="4" Click="Artwork_Click"
                        AllowDrop="True" DragEnter="Artwork_DragEnter" Drop="Artwork_Drop"
                        ToolTip="Browse release-matched covers, or drop one JPEG, PNG, or BMP here"
                        AutomationProperties.Name="Choose album artwork">
                  <Grid>
                    <Border Width="132" Height="132" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}"
                            BorderThickness="1"
                            Visibility="{Binding HasArtPreview, Converter={StaticResource BoolVis}}">
                      <Image Source="{Binding ArtPreview}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Choose or drop cover" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource InkDim}"
                               Visibility="{Binding HasArtPreview, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                  </Grid>
                </Button>
                <TextBlock Text="{Binding ArtInfo}" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" FontSize="9.5"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- left: live disc read-map -->
      <Border Grid.Column="0" Grid.RowSpan="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="16,18">
        <ScrollViewer x:Name="RipLeftRailScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Top">
          <!-- 3D disc on GPU-accelerated hardware; the 2D read-map is the software-rendering fallback -->
          <Viewbox MaxWidth="216" MaxHeight="216" Stretch="Uniform"
                   Visibility="{Binding Supports3DDisc, Converter={StaticResource BoolVis}}">
            <ctl:DiscModel3D Width="216" Height="216"
                             Progress="{Binding RipProgress, Mode=OneWay}" Active="{Binding IsRipping, Mode=OneWay}"
                             RereadActive="{Binding RereadActive, Mode=OneWay}" RereadFrac="{Binding RereadFrac, Mode=OneWay}"
                             Unreadable="{Binding Unreadable, Mode=OneWay}"/>
          </Viewbox>
          <Viewbox MaxWidth="216" MaxHeight="216" Stretch="Uniform"
                   Visibility="{Binding Supports3DDisc, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <ctl:DiscReadMap Width="216" Height="216"
                             Progress="{Binding RipProgress, Mode=OneWay}"
                             Spinning="{Binding IsRipping, Mode=OneWay}"/>
          </Viewbox>
          <TextBlock Text="reading inside-out" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          <Border Margin="0,16,0,0" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="10" Padding="11,9">
            <StackPanel>
              <DockPanel LastChildFill="False" Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Left" Text="READ LEVEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                <TextBlock DockPanel.Dock="Right" Text="dB -20 . 0 . +3" FontFamily="{StaticResource Mono}" FontSize="9.5" Foreground="{DynamicResource Muted}"/>
              </DockPanel>
              <ctl:VuMeter Height="74" Active="{Binding IsRipping, Mode=OneWay}"
                           LevelL="{Binding LevelL, Mode=OneWay}" LevelR="{Binding LevelR, Mode=OneWay}"/>
            </StackPanel>
          </Border>
          <Border Margin="0,11,0,0" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="10" Padding="11,9">
            <StackPanel>
              <DockPanel LastChildFill="False" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="READ SPEED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Teal}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource InkDim}"/>
              </DockPanel>
              <ctl:SpeedGraph Height="64" Level="{Binding SpeedLevel, Mode=OneWay}" Active="{Binding IsRipping, Mode=OneWay}"/>
            </StackPanel>
          </Border>
          <!-- appears only when the drive is genuinely re-reading a stuck sector (scratch / pin-hole);
               every number is the drive's real retry count, not a canned animation -->
          <Border Margin="0,11,0,0" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="10" Padding="11,9"
                  Visibility="{Binding RereadVisible, Converter={StaticResource BoolVis}}">
            <StackPanel>
              <DockPanel LastChildFill="False" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="RE-READING" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding RereadText}" FontFamily="{StaticResource Mono}" FontSize="9.5" Foreground="{DynamicResource Muted}"/>
              </DockPanel>
              <ctl:RereadScope Height="56" Active="{Binding RereadActive, Mode=OneWay}"
                               Count="{Binding RereadCount, Mode=OneWay}" Max="{Binding RereadMax, Mode=OneWay}"
                               Errors="{Binding RereadErrors, Mode=OneWay}"/>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Row="0" Grid.Column="1" Margin="18,16,18,8">
        <TextBlock x:Name="AlbumTitleText" Text="{Binding AlbumTitle}" ToolTip="{Binding AlbumTitle}"
                   FontFamily="{StaticResource Serif}" FontSize="24" Foreground="{DynamicResource Ink}"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding AlbumArtist}" ToolTip="{Binding AlbumArtist}"
                   FontFamily="{StaticResource Serif}" FontStyle="Italic" FontSize="14"
                   Foreground="{DynamicResource InkDim}" Margin="0,2,0,0"
                   TextTrimming="CharacterEllipsis"/>
        <!-- why this release was chosen (all matches fit the disc; ranked by source + completeness) -->
        <TextBlock Text="{Binding SelectedRelease.Why}" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"
                   Visibility="{Binding HasReleases, Converter={StaticResource BoolVis}}"/>
      </StackPanel>

      <ListView Grid.Row="1" Grid.Column="1" Margin="18,4,18,4" ItemsSource="{Binding Tracks}"
                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Foreground="{DynamicResource Ink}">
        <!-- hover: a low-opacity teal tint (TealSoft) over the panel, not the default near-white
             system highlight - subtle enough that the normal Ink text keeps its contrast, so no
             Foreground override is needed here.
             selection: solid teal fill + FIXED dark text. The cells inherit Foreground, and dark
             ink on the teal fill keeps contrast in BOTH themes (dark mode's normal ink is light,
             which washes out on teal). Selected+hovered still resolves to the selected look,
             since this trigger is declared after IsMouseOver. -->
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TealSoft}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Teal}"/>
                <Setter Property="Foreground" Value="#10201C"/>
                <Setter Property="BorderBrush" Value="{StaticResource Teal}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
          <GridView>
            <GridViewColumn Header="#" Width="32" DisplayMemberBinding="{Binding Number}"/>
            <GridViewColumn Header="Title" Width="174">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Grid>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <!-- live per-track read progress (only while ripping) -->
                    <ProgressBar Height="2" VerticalAlignment="Bottom" Margin="0,0,6,-3" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                 Background="Transparent" Foreground="{DynamicResource Teal}" BorderThickness="0"
                                 Visibility="{Binding DataContext.IsRipping, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolVis}}"/>
                  </Grid>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Len" Width="52" DisplayMemberBinding="{Binding LengthText}"/>
            <GridViewColumn Header="Test CRC" Width="102">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding TestCrc}" ToolTip="{Binding CrcEvidenceTip}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CrcsMatch}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Good}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CrossDriveCorroborated}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Teal2}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CrcsDiffer}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Copy CRC" Width="102">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding CopyCrc}" ToolTip="{Binding CrcEvidenceTip}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CrcsMatch}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Good}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CrossDriveCorroborated}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Teal2}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CrcsDiffer}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="AR" Width="48" DisplayMemberBinding="{Binding ArResult}"/>
            <GridViewColumn Header="CTDB" Width="52" DisplayMemberBinding="{Binding CtdbResult}"/>
          </GridView>
        </ListView.View>
      </ListView>

      <!-- during a rip: an educational view of what the codec is doing to the audio -->
      <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" Margin="18,0,18,10"
              Background="{DynamicResource Face}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Padding="14,11"
              Visibility="{Binding IsRipping, Converter={StaticResource BoolVis}}">
        <ctl:CodecScope Height="150" Codec="{Binding ScopeCodec, Mode=OneWay}" Mode="{Binding ScopeMode, Mode=OneWay}" Active="{Binding IsRipping, Mode=OneWay}"
                        Recovering="{Binding RereadActive, Mode=OneWay}" Samples="{Binding SampleWindow, Mode=OneWay}"/>
      </Border>

      <!-- rip complete: a clear finished state with the result + where the files went -->
      <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="18,10,18,0"
              Background="{DynamicResource Glass}" BorderBrush="{StaticResource Good}" BorderThickness="1" CornerRadius="11" Padding="16,13"
              Visibility="{Binding RipDone, Converter={StaticResource BoolVis}}">
        <DockPanel LastChildFill="True">
          <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Fill="{StaticResource Good}" VerticalAlignment="Top" Margin="0,2,12,0">
            <Ellipse.Effect><DropShadowEffect Color="#5CCB8B" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
          </Ellipse>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button Content="Repair from CTDB" Command="{Binding RepairLastRipCommand}" Style="{StaticResource Accent}" Padding="12,6" Margin="0,0,8,0"
                    Visibility="{Binding CanRepairLastRip, Converter={StaticResource BoolVis}}"
                    ToolTip="Create a separately verified repaired sibling. The completed rip remains unchanged."/>
            <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Style="{StaticResource Accent}" Padding="12,6"/>
            <Button Content="Dismiss" Command="{Binding DismissDoneCommand}" Padding="10,6" Margin="8,0,0,0"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Rip complete" Foreground="{DynamicResource Ink}" FontFamily="{StaticResource Serif}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding RipSummary}" Foreground="{DynamicResource InkDim}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding RepairLastRipText}" Foreground="{StaticResource Amber}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LastOutputDir}" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource Face}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}"
                       Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
            <ProgressBar Height="4" MaxWidth="240" Minimum="0" Maximum="1"
                         Value="{Binding RipProgress, Mode=OneWay}" Margin="0,5,0,0"
                         HorizontalAlignment="Stretch"
                         Background="{DynamicResource Glass}" Foreground="{StaticResource Teal}" BorderThickness="0"/>
            <!-- where the ripped album folder is created -->
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="saves to" Foreground="{DynamicResource Muted}"
                         FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Grid.Column="1" Text="{Binding OutputBaseDir}" ToolTip="{Binding OutputBaseDir}"
                         Foreground="{DynamicResource InkDim}" FontFamily="{StaticResource Mono}"
                         FontSize="10.5" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
              <Button Grid.Column="2" Content="Change..." Command="{Binding BrowseOutputCommand}"
                      Padding="8,2" Margin="8,0,0,0" FontSize="10.5"
                      ToolTip="Choose the base folder. Each album gets its own 'Artist - Album' subfolder here."/>
            </Grid>
          </StackPanel>

          <!-- Wrap instead of clipping when side rails leave a narrow center column. Every command
               remains reachable; below the 860-pixel work-area minimum the outer scroller is the
               final fallback. Stop replaces the primary actions while a read is active. -->
          <WrapPanel x:Name="RipActionWrap" Grid.Row="1" Margin="0,10,0,0"
                     HorizontalAlignment="Right">
            <ComboBox Width="104" Margin="0,0,10,6" SelectedIndex="{Binding CorrectionQuality, Mode=TwoWay}"
                      IsEnabled="{Binding ControlsUnlocked}" VerticalAlignment="Center"
                      ToolTip="Burst: fast, single pass - windows the vote flags still re-read up to 16 passes, but deep recovery never runs. Secure: read twice + compare, with deep recovery. Paranoid: deepest re-reads. Salvage: for defective-by-design discs - Test &amp; Copy at Burst quality with C2 off at minimum speed; agreement proves the drive's output is stable, and the result is labeled salvaged, never verified.">
              <ComboBoxItem>Burst</ComboBoxItem>
              <ComboBoxItem>Secure</ComboBoxItem>
              <ComboBoxItem>Paranoid</ComboBoxItem>
              <ComboBoxItem>Salvage</ComboBoxItem>
            </ComboBox>
            <Button Width="210" MinWidth="150" Margin="0,0,6,6"
                    VerticalAlignment="Center" IsEnabled="{Binding CodecUnlocked}"
                    Click="CodecPicker_Click" ToolTip="{Binding SelectedCodecTooltip}"
                    AutomationProperties.Name="Choose output codec">
              <TextBlock Text="{Binding SelectedCodecLabel}"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </Button>
            <ComboBox Width="176" Margin="0,0,6,6" VerticalAlignment="Center"
                      ItemsSource="{Binding OutputLayouts}"
                      SelectedItem="{Binding SelectedOutputLayout, Mode=TwoWay}"
                      IsEnabled="{Binding ControlsUnlocked}"
                      ToolTip="Tracks: one tagged file per track (default). Image + embedded CUE: one continuous audio file with the complete disc layout stored in its tags."/>
            <Button Content="tune" FontFamily="{StaticResource Mono}" FontSize="11"
                    Padding="9,6" Margin="0,0,10,6" VerticalAlignment="Center"
                    Click="EncoderSettings_Click" IsEnabled="{Binding CodecUnlocked}"
                    ToolTip="Encoder settings for the selected format: compression / quality mode and every advanced option the codec exposes, each with an explanation."/>
            <Button Content="Test &amp; Copy" Command="{Binding TestCopyCommand}"
                    Padding="18,9" Margin="0,0,10,6"
                    Visibility="{Binding IsRipping, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                    ToolTip="Read the disc twice (a third time on a mismatch) and write only tracks two independent reads agree on bit-for-bit. First use calibrates the drive automatically; cached re-reads are flushed. Slower (2-3x reads). Best for discs not in AccurateRip."/>
            <Button Content="Rip" Command="{Binding RipCommand}" Style="{StaticResource Accent}"
                    Padding="18,9" Margin="0,0,10,6"
                    Visibility="{Binding IsRipping, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
            <Button Content="Verify" Command="{Binding VerifyCommand}" Padding="18,9"
                    Margin="0,0,0,6"
                    Visibility="{Binding IsRipping, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
            <!-- A live job stays pinned to its immutable drive snapshot. Start another drive
                 in an isolated process instead of sharing this page's Stop/CUESheet/staging
                 state. The OS-wide physical-drive lease rejects same-drive collisions. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,6"
                        Visibility="{Binding ShowParallelDriveLauncher, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Another drive" Foreground="{DynamicResource Muted}"
                         FontSize="10.5" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <ComboBox Width="64" ItemsSource="{Binding ParallelDrives}"
                        SelectedItem="{Binding ParallelDrive, Mode=TwoWay}"
                        VerticalAlignment="Center" Margin="0,0,6,0"
                        ToolTip="A different attached optical drive. The active drive is intentionally excluded."/>
              <Button Content="Open window" Command="{Binding OpenParallelDriveCommand}"
                      Padding="11,7"
                      ToolTip="Open an isolated CUETools drive window. Both drives can rip at once; same-drive use is blocked."/>
            </StackPanel>
            <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource Accent}"
                    Padding="18,9" Margin="0,0,0,6"
                    Visibility="{Binding IsRipping, Converter={StaticResource BoolVis}}"
                    ToolTip="Stop the rip or verify. It finishes the current block, then stops cleanly."/>
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>
    </ScrollViewer>

    <!-- no disc: status + recently ripped. Keyed off ShowDiscArea, NOT IsDiscPresent: this sits in
         the SAME grid cell as the disc area and is declared after it, so with eject-after-rip on
         (IsDiscPresent false, RipDone still true) it painted its opaque panel straight over the
         completion summary - hiding the output path, "Open folder" and "Dismiss". -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding ShowDiscArea, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
      <StackPanel Margin="24">
        <!-- the drive tray: slides out on Eject, pulls in on Close, then the disc reads itself -->
        <ctl:DiscTray Width="264" Height="150" HorizontalAlignment="Center" Margin="0,2,0,6"
                      Open="{Binding IsTrayOpen, Mode=OneWay}"/>
        <TextBlock Text="Drop in a disc and press Close (or the drive's own button) - it reads automatically."
                   Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" FontSize="10.5"
                   HorizontalAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap" TextAlignment="Center"
                   Visibility="{Binding IsTrayOpen, Converter={StaticResource BoolVis}}"/>
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="18,15" Margin="0,4,0,18">
          <StackPanel>
            <TextBlock Text="{Binding AlbumTitle}" FontFamily="{StaticResource Serif}" FontSize="20" Foreground="{DynamicResource Ink}"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- empty state: no history yet (honest - shown until real rips accumulate) -->
        <TextBlock Text="No rips yet. Insert a disc and rip or verify it - the last ten show up here so you can keep a stack of discs straight."
                   Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="2,0,0,0"
                   Visibility="{Binding Recent.Count, Converter={StaticResource ZeroToVis}}"/>

        <!-- history list (header + rows) hidden until there is at least one entry -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Recent.Count}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="RECENTLY RIPPED - LAST 10" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="2,0,0,9"/>
          <ItemsControl ItemsSource="{Binding Recent}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="13,10" Margin="0,0,0,8">
                  <!-- Order matters: DockPanel reserves space in declaration order. When docks
                       first so the timestamp always shows, then Result fills the leftover middle
                       and trims there, keeping its full value in a tooltip. -->
                  <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left">
                      <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Serif}" FontSize="14" Foreground="{DynamicResource Ink}"/>
                      <TextBlock Text="{Binding Artist}" FontFamily="{StaticResource Serif}" FontStyle="Italic" FontSize="11.5" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBlock Text="{Binding Result}" Foreground="{StaticResource Teal}" FontFamily="{StaticResource Mono}" FontSize="11.5" VerticalAlignment="Center" Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Result}"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
