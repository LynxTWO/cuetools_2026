<Window x:Class="CUETools.Wpf.Views.ArtworkBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose album artwork"
        Width="1040" Height="700" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AllowDrop="True" DragEnter="Window_DragEnter" Drop="Window_Drop"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource Ink}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Choose album artwork" FontFamily="{StaticResource Serif}"
                   FontSize="25" Foreground="{DynamicResource Ink}"/>
        <TextBlock Text="{Binding ReleaseTitle}" Margin="0,3,0,0"
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
        <Button Content="Add local image..." Padding="14,6" Margin="0,0,8,0"
                Click="AddLocal_Click"/>
        <Button Content="Recommended sort" Padding="14,6" Margin="0,0,8,0"
                Click="Recommended_Click"/>
        <CheckBox x:Name="AllArtworkCheckBox" Content="All artwork"
                  VerticalAlignment="Center" Margin="0,0,12,0"
                  Checked="AllArtwork_Changed" Unchecked="AllArtwork_Changed"/>
        <Button Content="Refresh" Padding="14,6"
                Click="Refresh_Click" VerticalAlignment="Center"/>
      </WrapPanel>
    </DockPanel>

    <Border Grid.Row="1" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="10" Padding="1">
      <DataGrid x:Name="ResultsGrid"
                ItemsSource="{Binding Rows}"
                SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserAddRows="False" CanUserDeleteRows="False"
                IsReadOnly="True" SelectionMode="Single"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                RowBackground="{DynamicResource Panel}"
                AlternatingRowBackground="{DynamicResource Glass}"
                Foreground="{DynamicResource Ink}"
                BorderThickness="0"
                EnableRowVirtualization="True"
                EnableColumnVirtualization="True"
                Sorting="ResultsGrid_Sorting"
                MouseDoubleClick="ResultsGrid_MouseDoubleClick">
        <DataGrid.Resources>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Bar}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Padding" Value="9,7"/>
          </Style>
          <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Padding" Value="6,4"/>
          </Style>
        </DataGrid.Resources>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Preview" Width="108" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid Width="88" Height="88">
                  <Border Background="{DynamicResource Glass}"
                          BorderBrush="{DynamicResource GlassLine}"
                          BorderThickness="1" CornerRadius="5"/>
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                         AutomationProperties.Name="{Binding Source}"/>
                  <TextBlock Text="{Binding LoadStatus}" Foreground="{DynamicResource Muted}"
                             FontSize="10" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150"
                              SortMemberPath="Source"/>
          <DataGridTextColumn Header="Match" Binding="{Binding Match}" Width="175"
                              SortMemberPath="MatchOrder"/>
          <DataGridTextColumn Header="Dimensions" Binding="{Binding Dimensions}" Width="115"
                              SortMemberPath="PixelArea"/>
          <DataGridTextColumn Header="File size" Binding="{Binding FileSize}" Width="100"
                              SortMemberPath="ByteLength"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Approval}" Width="90"
                              SortMemberPath="Approval"/>
          <DataGridTextColumn Header="Type" Binding="{Binding ArtworkType}" Width="85"
                              SortMemberPath="ArtworkType"/>
          <DataGridTextColumn Header="Why this matched" Binding="{Binding Why}" Width="*"
                              CanUserSort="False"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,18,0">
        <TextBlock
                   Text="Recommended sorts by release identity first. Unknown dimensions and sizes are shown honestly until the original is selected."
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        <Button Content="Open source page" HorizontalAlignment="Left" Margin="0,6,0,0"
                Padding="10,4" IsEnabled="{Binding HasSelectedSourcePage}"
                Click="OpenSource_Click"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <Button Content="No cover" Padding="14,6" Margin="0,0,8,0"
                Click="NoCover_Click"/>
        <Button Content="Use automatic" Padding="14,6" Margin="0,0,8,0"
                Click="Automatic_Click"/>
        <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0"
                IsCancel="True"/>
        <Button Content="Use selected" Padding="16,6"
                Style="{StaticResource Accent}" IsDefault="True"
                Click="UseSelected_Click"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>
