<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:CUETools.Wpf.Controls">

  <!-- Accent colors (same in both themes). The THEMEABLE structural brushes - Ground, Bar, Face,
       Panel, Line, Ink, InkDim, Muted, Glass, GlassLine, ButtonPressed, ButtonFace - are NOT
       defined here: ThemeService creates them as single mutable brush objects in the app resources
       and recolors them on light/dark toggle, so every DynamicResource consumer updates from the
       one brush (no ambiguous frozen duplicate to fight). -->
  <SolidColorBrush x:Key="Teal"     Color="#34CFC0"/>
  <SolidColorBrush x:Key="Teal2"    Color="#46B8E0"/>
  <SolidColorBrush x:Key="Amber"    Color="#E9A63F"/>
  <SolidColorBrush x:Key="Good"     Color="#5CCB8B"/>
  <SolidColorBrush x:Key="TealSoft" Color="#2434CFC0"/>

  <!-- Switch "bulb" colors as a one-knob ramp (see the lit-panel-controls skill). The Switch
       template references these via DynamicResource, so a settings section can color-code its
       switches by overriding these Color keys in its own Resources scope. Default = teal. -->
  <Color x:Key="LampCore">#EAFFFB</Color>
  <Color x:Key="LampLight">#6FE3D6</Color>
  <Color x:Key="LampBase">#27A99C</Color>
  <Color x:Key="LampDark">#0E4F48</Color>
  <Color x:Key="LampEdge">#06211E</Color>
  <Color x:Key="LampHalo">#34CFC0</Color>
  <Color x:Key="LampCapCore">#B8F1FBF9</Color>
  <Color x:Key="LampCapMid">#5A45D6C9</Color>
  <Color x:Key="LampCapEdge">#0034CFC0</Color>

  <!-- Lead each stack with a font that ships on every Windows and is unlikely to have a broken
       font-cache entry (Cascadia Mono was found broken on a test machine, throwing FileNotFoundException
       in DWrite and aborting the whole window). The nicer faces stay as fallbacks. -->
  <FontFamily x:Key="Serif">Sitka Text, Cambria, Georgia, serif</FontFamily>
  <FontFamily x:Key="Mono">Consolas, Cascadia Mono, monospace</FontFamily>

  <!-- The keyboard-only focus ring, drawn on the adorner layer over the key. Defined before the
       key style because StaticResource resolves backwards through the dictionary. -->
  <Style x:Key="KeyFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border CornerRadius="7" BorderThickness="1" SnapsToDevicePixels="True"
                  BorderBrush="{DynamicResource StatusAccent}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- THE MACHINED KEY. A console key sits flush IN its housing, it does not float above the
       panel. Five layers, back to front: the recess it sits in; the housing lamp seen through the
       seam around the cap; the cap itself; the cap's own dome (shoulder, crown, lip); and the
       label with its legend strip. Pressing sinks the cap 1.2px and takes the housing lamp up.

       Hover and press are told by LIGHT, not by an outline. An outline is a UI convention wearing
       a console's clothes; a real key in a lit housing shows more of that light as it moves.

       Corner radius is fixed at 7 rather than TemplateBound: WPF's Button, unlike Avalonia's, has
       no CornerRadius property. Every layer that rounds must repeat the number.

       Ported from the Linux head's Theme/AnalogControls.axaml, whose comments carry the reasoning
       for each layer. The floating rubber cap and its BendyButton squash that stood here before
       modelled a different object and could not be reconciled with this one. -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource ButtonFace}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <!-- Keyboard-only ring. WPF draws FocusVisualStyle only when the most recent input device was
         the keyboard, which is exactly what Avalonia's :focus-visible means; a trigger on
         IsKeyboardFocused would light after every mouse click too. -->
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ControlTemplate.Resources>
            <DropShadowEffect x:Key="KeyFaceShadow" Color="#000000"
                              BlurRadius="4" ShadowDepth="1.5" Direction="270" Opacity="0.31"/>
            <DropShadowEffect x:Key="KeyFaceShadowPressed" Color="#000000"
                              BlurRadius="1.5" ShadowDepth="0.5" Direction="270" Opacity="0.31"/>
            <!-- Light coming THROUGH the legend, not grey ink sitting on it: zero depth, same
                 recipe as the lit rail glyphs. -->
            <DropShadowEffect x:Key="LegendGlow" Color="{DynamicResource StatusAccentColor}"
                              BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
            <DropShadowEffect x:Key="StandbyGlow" Color="{DynamicResource KeyStandbyGlowColor}"
                              BlurRadius="5" ShadowDepth="0" Opacity="0.2"/>
          </ControlTemplate.Resources>
          <!-- Nothing here may clip: the seam lamp's bloom spills outside the cap by design, and a
               clip would cut it square at the bounds. -->
          <Grid ClipToBounds="False">
            <!-- The housing wall behind the cap. Invisible while the cap fills its own bounds. -->
            <Border x:Name="keyRecess" CornerRadius="7" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource ButtonEdge}"/>
            <!-- The housing lamp, seen through the gap around the cap's skirt. The zero-x-offset
                 shadow is its spill onto the console. -->
            <Border x:Name="keySeam" CornerRadius="7" Opacity="0" IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="{DynamicResource KeySeamColor}" Offset="0"/>
                  <GradientStop Color="{DynamicResource KeySeamColor}" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <DropShadowEffect Color="{DynamicResource KeySeamColor}"
                                  BlurRadius="19" ShadowDepth="1" Direction="270" Opacity="0.9"/>
              </Border.Effect>
            </Border>
            <Border x:Name="keyFace" CornerRadius="7"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Effect="{StaticResource KeyFaceShadow}">
              <Border.RenderTransform>
                <TranslateTransform Y="0"/>
              </Border.RenderTransform>
              <Grid>
                <!-- The cap is a DOMED piece, not a flat panel. (a) shoulder: curvature falloff,
                     so it turns away and darkens toward every edge. (b) crown: the bulge catching
                     the bench light, high and off-centre upward. (c) lip: a bright hairline along
                     the top edge and a shadow along the bottom, the cap's own thickness edge on. -->
                <Border x:Name="keyShoulder" CornerRadius="7" IsHitTestVisible="False">
                  <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.45" Center="0.5,0.45"
                                         RadiusX="0.62" RadiusY="0.78">
                      <GradientStop Color="#00000000" Offset="0"/>
                      <GradientStop Color="#00000000" Offset="0.55"/>
                      <GradientStop Color="{DynamicResource KeyShoulderMidColor}" Offset="0.88"/>
                      <GradientStop Color="{DynamicResource KeyShoulderEdgeColor}" Offset="1"/>
                    </RadialGradientBrush>
                  </Border.Background>
                </Border>
                <Border x:Name="keyCrown" CornerRadius="7" IsHitTestVisible="False">
                  <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.22" Center="0.5,0.22"
                                         RadiusX="0.58" RadiusY="0.62">
                      <GradientStop Color="{DynamicResource KeyCrownCoreColor}" Offset="0"/>
                      <GradientStop Color="{DynamicResource KeyCrownMidColor}" Offset="0.5"/>
                      <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                  </Border.Background>
                </Border>
                <Border x:Name="keyLip" CornerRadius="7" IsHitTestVisible="False"
                        BorderThickness="0,1,0,1">
                  <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="{DynamicResource KeyLipTopColor}" Offset="0"/>
                      <GradientStop Color="{DynamicResource KeyLipBottomColor}" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.BorderBrush>
                </Border>
                <StackPanel Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                  <ContentPresenter x:Name="keyContent"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    RecognizesAccessKey="True"/>
                  <!-- The backlit legend strip. Transport keys reveal it. -->
                  <Border x:Name="legend" Height="3" MinWidth="34" CornerRadius="1.5"
                          Margin="0,4,0,0" HorizontalAlignment="Center" Visibility="Collapsed"
                          Background="{DynamicResource StatusAccent}" Opacity="0.45"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Approaching the key brings the lamp up to a low glow. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="keySeam"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0.34" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="keySeam"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <!-- Pressing it takes the lamp up and sinks the cap into the housing. -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="keyFace" Property="Background" Value="{DynamicResource ButtonPressed}"/>
              <Setter TargetName="keyFace" Property="Effect" Value="{StaticResource KeyFaceShadowPressed}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="keySeam"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0.85" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="keyFace"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     To="1.2" Duration="0:0:0.08"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="keySeam"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="keyFace"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     To="0" Duration="0:0:0.08"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <!-- Transport keys carry the legend strip; the primary one is lit. -->
            <Trigger Property="ctl:KeyStyle.Role" Value="Transport">
              <Setter TargetName="legend" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="ctl:KeyStyle.Role" Value="TransportPrimary">
              <Setter TargetName="legend" Property="Visibility" Value="Visible"/>
              <Setter TargetName="legend" Property="Opacity" Value="1"/>
              <Setter TargetName="legend" Property="Effect" Value="{StaticResource LegendGlow}"/>
            </Trigger>
            <!-- A dead key is unpowered, not blanked. The legend on a console key is a translucent
                 window with a bulb behind it; turning the key off turns that bulb down to standby
                 rather than out, so the label still carries a faint light and stays readable.
                 WCAG 1.4.3 exempts inactive controls; every ENABLED state keeps its contrast. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource KeyStandby}"/>
              <Setter TargetName="keySeam" Property="Opacity" Value="0"/>
              <Setter TargetName="keyContent" Property="Effect" Value="{StaticResource StandbyGlow}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ctl:KeyStyle.Role" Value="Transport"/>
                <Condition Property="IsEnabled" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="legend" Property="Background" Value="{DynamicResource Line}"/>
              <Setter TargetName="legend" Property="Opacity" Value="1"/>
              <Setter TargetName="legend" Property="Effect" Value="{x:Null}"/>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ctl:KeyStyle.Role" Value="TransportPrimary"/>
                <Condition Property="IsEnabled" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="legend" Property="Background" Value="{DynamicResource Line}"/>
              <Setter TargetName="legend" Property="Opacity" Value="1"/>
              <Setter TargetName="legend" Property="Effect" Value="{x:Null}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The accent key: the same machined cap in the accent metal. Setters only - no second
       template, so state behaviour cannot drift between the two. -->
  <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource AccentKeyText}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="{DynamicResource AccentKeyTopColor}" Offset="0"/>
          <GradientStop Color="{DynamicResource AccentKeyBottomColor}" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- An unpowered accent key is not a teal key with dim text: it is off, so it returns to the
           ordinary face and its label drops to standby with every other dead key. -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource ButtonFace}"/>
        <Setter Property="Foreground" Value="{DynamicResource KeyStandby}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- THE LAMP CHECKBOX. The lit-panel model at checkbox scale: a recessed housing with a lamp
       behind a lens, and an etched tick that the lamp lights from beneath. Checked warms fast
       (0.18s) and unchecked cools slow (0.34s), the way a filament does.

       Implicit, because until now this app had no CheckBox style at all and its two checkboxes
       rendered OS default - which is also the pair that adopted Windows high-contrast styling
       inside an otherwise palette-coloured window (see docs/evidence/2026-08-27-selector-high-
       contrast). One template settles both.

       The housing reuses the switch's own tokens rather than the Linux head's hardcoded darks, so
       the light theme gets a light housing instead of a black hole in a pale panel. -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <ControlTemplate.Resources>
            <DropShadowEffect x:Key="LampGlow" Color="{DynamicResource LampHalo}"
                              BlurRadius="10" ShadowDepth="0" Opacity="0.63"/>
          </ControlTemplate.Resources>
          <Grid ClipToBounds="False">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="housing" Width="22" Height="22" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource SwitchHousingBorder}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="{DynamicResource SwitchHousingTopColor}" Offset="0"/>
                  <GradientStop Color="{DynamicResource SwitchHousingBottomColor}" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Border x:Name="lens" CornerRadius="5" Margin="1" Opacity="0">
                  <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42"
                                         RadiusX="0.7" RadiusY="0.7">
                      <GradientStop Color="{DynamicResource LampCore}" Offset="0"/>
                      <GradientStop Color="{DynamicResource LampLight}" Offset="0.62"/>
                      <GradientStop Color="{DynamicResource LampCapEdge}" Offset="1"/>
                    </RadialGradientBrush>
                  </Border.Background>
                </Border>
                <!-- Etched into the cap, so it reads as part of the housing when the lamp is out
                     and as a shadow on the lens when it is lit. -->
                <Path x:Name="tick" Data="M 5,11 L 9.5,15.5 L 17,6.5"
                      Stroke="{DynamicResource LampTickOff}" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <!-- The specular on the lens cap. -->
                <Border Width="12" Height="3" CornerRadius="2" VerticalAlignment="Top"
                        HorizontalAlignment="Center" Margin="0,2.5,0,0"
                        Background="{DynamicResource SwitchSheen}"/>
              </Grid>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="tick" Property="Stroke" Value="{DynamicResource LampTickOn}"/>
              <Setter TargetName="housing" Property="Effect" Value="{StaticResource LampGlow}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="lens" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="lens" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.34">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="housing" Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            </Trigger>
            <!-- Unpowered, not blanked: the same standby treatment every dead control gets. The
                 lens stays lit because it carries STATE - a disabled option the user cannot change
                 must still say whether it is on - but the housing halo goes out, exactly as a dead
                 key's seam lamp does while its legend stays readable. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource KeyStandby}"/>
              <Setter Property="Cursor" Value="Arrow"/>
              <Setter TargetName="housing" Property="Effect" Value="{x:Null}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ROWS IN THE OPEN LIST. A lit pip beside the engaged one: the same detent language the key
       bank uses, so "this is the one" reads the same wherever it appears. The row itself only
       lifts to Glass under the pointer. -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Padding" Value="0,5,8,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <ControlTemplate.Resources>
            <DropShadowEffect x:Key="PipGlow" Color="{DynamicResource LampHalo}"
                              BlurRadius="7" ShadowDepth="0" Opacity="0.63"/>
          </ControlTemplate.Resources>
          <Border x:Name="rowFace" Background="Transparent" CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="rowPip" Width="3" Height="13" CornerRadius="1.5"
                      Margin="6,0,8,0" VerticalAlignment="Center" Opacity="0.35"
                      Background="{DynamicResource Line}"/>
              <ContentPresenter x:Name="rowContent" Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="rowFace" Property="Background" Value="{DynamicResource Glass}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="rowFace" Property="Background" Value="{DynamicResource ButtonFace}"/>
              <Setter TargetName="rowPip" Property="Background" Value="{DynamicResource StatusAccent}"/>
              <Setter TargetName="rowPip" Property="Opacity" Value="1"/>
              <Setter TargetName="rowPip" Property="Effect" Value="{StaticResource PipGlow}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- THE MACHINED WINDOW. A recessed glass window showing the current value, with a ridged
       thumbwheel on its right edge. The wheel is the part that says there is more than one value;
       a chevron says "menu", a wheel says "there are others behind this one".

       A template restyle of ComboBox, not a new control, so opening, keyboard handling and the
       accessible role are untouched. The old fixed Height="30" is gone: it would crush the glass
       and wheel into each other, and the housing sizes itself from its content. -->
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <ControlTemplate.Resources>
                    <DropShadowEffect x:Key="WindowStandbyGlow" Color="{DynamicResource KeyStandbyGlowColor}"
                                      BlurRadius="5" ShadowDepth="0" Opacity="0.2"/>
                  </ControlTemplate.Resources>
                  <Border x:Name="winHousing" CornerRadius="7" BorderThickness="1" Padding="2"
                          BorderBrush="{DynamicResource ButtonEdge}"
                          Background="{DynamicResource ButtonPressed}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- The glass: the lit window the value shows through. The explicit
                           Foreground is not decoration - this ContentPresenter sits inside a plain
                           ToggleButton whose default style sets black, which would otherwise beat
                           the ComboBox's inherited Ink and render black on a dark face. -->
                      <Border x:Name="winGlass" Background="{DynamicResource ButtonFace}"
                              CornerRadius="5,0,0,5" Padding="10,4,8,4">
                        <ContentPresenter x:Name="winValue" VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource Ink}"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                      </Border>
                      <!-- The thumbwheel. Dark down both vertical edges and clear through the
                           middle, which is what makes a flat rectangle read as a cylinder. -->
                      <Border x:Name="winWheel" Grid.Column="1" Width="20" CornerRadius="0,5,5,0">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource KeyShoulderEdgeColor}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.3"/>
                            <GradientStop Color="#00000000" Offset="0.7"/>
                            <GradientStop Color="{DynamicResource KeyShoulderEdgeColor}" Offset="1"/>
                          </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center">
                          <Border Height="1" Width="11" Opacity="0.5" Margin="0,0,0,2"
                                  HorizontalAlignment="Center" Background="{DynamicResource Line}"/>
                          <Border Height="1" Width="11" Margin="0,0,0,2"
                                  HorizontalAlignment="Center" Background="{DynamicResource Line}"/>
                          <Border Height="1" Width="11" Margin="0,0,0,2"
                                  HorizontalAlignment="Center" Background="{DynamicResource Line}"/>
                          <Border Height="1" Width="11" Margin="0,0,0,2"
                                  HorizontalAlignment="Center" Background="{DynamicResource Line}"/>
                          <Border Height="1" Width="11" Opacity="0.5"
                                  HorizontalAlignment="Center" Background="{DynamicResource Line}"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="winHousing" Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                    </Trigger>
                    <!-- A dead window keeps its value readable at standby, like a dead key's
                         legend. IsEnabled propagates from the ComboBox, so this catches both. -->
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="winValue" Property="TextElement.Foreground" Value="{DynamicResource KeyStandby}"/>
                      <Setter TargetName="winValue" Property="Effect" Value="{StaticResource WindowStandbyGlow}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border x:Name="winList" Margin="0,3,0,0" CornerRadius="6" Padding="2"
                      Background="{DynamicResource Panel}"
                      BorderBrush="{DynamicResource ButtonEdge}" BorderThickness="1"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <Border.Effect>
                  <DropShadowEffect Color="{DynamicResource ControlShadowColor}"
                                    BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.44"/>
                </Border.Effect>
                <ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- list column headers (Rip track list, Verify/Queue source lists) - themed, replacing the
       default white system header that read as a white bar on the dark surface. -->
  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Background" Value="{DynamicResource Bar}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="9,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
            <ContentPresenter TextElement.Foreground="{DynamicResource Muted}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Instrument-fader scrollbars. The system template's square arrow buttons and bright native
       trough cut across the bench-panel visual language, so scrollbars use a quiet recessed rail
       with a tactile illuminated grabber. Page-click, wheel, keyboard, and thumb-drag behavior
       remain the stock ScrollBar commands; only the presentation changes. -->
  <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="VerticalScrollThumb" TargetType="Thumb">
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Margin" Value="2,0"/>
    <Setter Property="Cursor" Value="SizeNS"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="thumbBody" CornerRadius="5" Background="{DynamicResource ScrollThumb}"
                  BorderBrush="{DynamicResource ScrollTrackBorder}" BorderThickness="1" SnapsToDevicePixels="True">
            <Grid>
              <Border Width="2" Height="12" CornerRadius="1" Background="{DynamicResource StatusAccent}" Opacity="0.42"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="thumbBody" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
              <Setter TargetName="thumbBody" Property="BorderBrush" Value="{DynamicResource StatusAccent}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="thumbBody" Property="Background" Value="{DynamicResource ScrollThumbPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="thumbBody" Property="Opacity" Value="0.25"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HorizontalScrollThumb" TargetType="Thumb">
    <Setter Property="MinWidth" Value="34"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="Cursor" Value="SizeWE"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="thumbBody" CornerRadius="5" Background="{DynamicResource ScrollThumb}"
                  BorderBrush="{DynamicResource ScrollTrackBorder}" BorderThickness="1" SnapsToDevicePixels="True">
            <Grid>
              <Border Width="12" Height="2" CornerRadius="1" Background="{DynamicResource StatusAccent}" Opacity="0.42"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="thumbBody" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
              <Setter TargetName="thumbBody" Property="BorderBrush" Value="{DynamicResource StatusAccent}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="thumbBody" Property="Background" Value="{DynamicResource ScrollThumbPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="thumbBody" Property="Opacity" Value="0.25"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
    <Grid Width="12" Background="Transparent" SnapsToDevicePixels="True">
      <Border Width="4" Margin="0,2" HorizontalAlignment="Center" CornerRadius="2"
              Background="{DynamicResource ScrollTrack}" BorderBrush="{DynamicResource ScrollTrackBorder}" BorderThickness="1"/>
      <Track x:Name="PART_Track" Margin="1,3" IsDirectionReversed="True"
             Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
             ViewportSize="{TemplateBinding ViewportSize}"
             Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{StaticResource ScrollPageButton}"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Style="{StaticResource VerticalScrollThumb}"/></Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{StaticResource ScrollPageButton}"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
    <Grid Height="12" Background="Transparent" SnapsToDevicePixels="True">
      <Border Height="4" Margin="2,0" VerticalAlignment="Center" CornerRadius="2"
              Background="{DynamicResource ScrollTrack}" BorderBrush="{DynamicResource ScrollTrackBorder}" BorderThickness="1"/>
      <Track x:Name="PART_Track" Margin="3,1" IsDirectionReversed="False"
             Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
             ViewportSize="{TemplateBinding ViewportSize}"
             Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{StaticResource ScrollPageButton}"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Style="{StaticResource HorizontalScrollThumb}"/></Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{StaticResource ScrollPageButton}"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- left-nav item -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="b" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource Panel}"/>
              <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource TealSoft}"/>
              <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Physical lit toggle. A translucent plastic housing with a bulb behind it. OFF: dark, cap
       left. ON: the bulb lights the exposed plastic (lit lens on the left), the light bleeds
       faintly through the cap, and the cap slides right. The transition is animated with real
       physics: the cap snaps across (slight mechanical overshoot), the bulb WARMS UP quickly, and
       on OFF it COOLS DOWN with a longer dim tail like an incandescent filament. The cap parts
       ride together in a translated "mover"; the lens opacity carries the warm/cool curve. -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Width" Value="50"/>
    <Setter Property="Height" Value="25"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <!-- housing: recessed translucent plastic (fixed) -->
            <Border x:Name="housing" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource SwitchHousingBorder}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="{DynamicResource SwitchHousingTopColor}" Offset="0"/>
                  <GradientStop Color="{DynamicResource SwitchHousingBottomColor}" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <!-- carved channel: a top-dark / bottom-light inner rim so the cap reads as sitting
                 DOWN INSIDE the housing (WPF has no inner-shadow, so this thin gradient stroke
                 fakes the recess - shadow pooling under the top lip, a faint lit bottom edge). -->
            <Border x:Name="channel" CornerRadius="11" Margin="1" BorderThickness="1.2">
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="{DynamicResource SwitchChannelTopColor}" Offset="0"/>
                  <GradientStop Color="{DynamicResource SwitchChannelMidColor}" Offset="0.45"/>
                  <GradientStop Color="{DynamicResource SwitchChannelBottomColor}" Offset="1"/>
                </LinearGradientBrush>
              </Border.BorderBrush>
            </Border>

            <!-- bulb glow behind the plastic (lit lens on the left) + the outer teal halo, both
                 carried by this layer's Opacity (0 off, warms to 1 on). -->
            <Border x:Name="glow" CornerRadius="12" Opacity="0" Margin="1">
              <Border.Background>
                <RadialGradientBrush GradientOrigin="0.3,0.5" Center="0.3,0.5" RadiusX="0.72" RadiusY="1.15">
                  <GradientStop Color="{DynamicResource LampCore}" Offset="0"/>
                  <GradientStop Color="{DynamicResource LampLight}" Offset="0.26"/>
                  <GradientStop Color="{DynamicResource LampBase}" Offset="0.52"/>
                  <GradientStop Color="{DynamicResource LampDark}" Offset="0.78"/>
                  <GradientStop Color="{DynamicResource LampEdge}" Offset="1"/>
                </RadialGradientBrush>
              </Border.Background>
              <!-- The plastic thickens toward the rim, so the light must die out before any edge
                   or corner. A vignette mask takes the glow to zero INSIDE the housing rather than
                   letting the border clip it, which is what produced the hard stop at the corners
                   the owner reported on the Linux head. -->
              <Border.OpacityMask>
                <RadialGradientBrush GradientOrigin="0.38,0.5" Center="0.38,0.5" RadiusX="0.64" RadiusY="0.72">
                  <GradientStop Color="#FFFFFFFF" Offset="0"/>
                  <GradientStop Color="#FFFFFFFF" Offset="0.42"/>
                  <GradientStop Color="#00FFFFFF" Offset="0.97"/>
                </RadialGradientBrush>
              </Border.OpacityMask>
              <Border.Effect><DropShadowEffect Color="{DynamicResource LampHalo}" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
            </Border>

            <!-- mover: the cap and everything riding with it, translated on toggle -->
            <Grid x:Name="mover" Width="21" Height="19" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
              <Grid.RenderTransform><TranslateTransform x:Name="slide" X="0"/></Grid.RenderTransform>

              <!-- soft recess shadow the cap casts on the lit plastic beneath it -->
              <Border x:Name="occlude" Width="23" Height="21" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                <Border.Background>
                  <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
                    <GradientStop Color="#73000000" Offset="0"/>
                    <GradientStop Color="#3C000000" Offset="0.65"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                  </RadialGradientBrush>
                </Border.Background>
              </Border>

              <!-- slider cap: thick beveled dark plastic -->
              <Border x:Name="thumb" Width="21" Height="19" CornerRadius="5">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource SwitchThumbTopColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource SwitchThumbMidColor}" Offset="0.5"/>
                    <GradientStop Color="{DynamicResource SwitchThumbBottomColor}" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <!-- deeper cast so the cap reads as seated down in the channel, not raised above it -->
                <Border.Effect><DropShadowEffect Color="{DynamicResource ControlShadowColor}" BlurRadius="4" ShadowDepth="2.2" Direction="270" Opacity="0.55"/></Border.Effect>
              </Border>

              <!-- light bleeding through the thick plastic cap, on the lens-facing edge -->
              <Border x:Name="capBleed" Width="21" Height="19" CornerRadius="5" Opacity="0">
                <Border.Background>
                  <RadialGradientBrush GradientOrigin="0.1,0.62" Center="0.1,0.62" RadiusX="0.95" RadiusY="1.0">
                    <GradientStop Color="{DynamicResource LampCapCore}" Offset="0"/>
                    <GradientStop Color="{DynamicResource LampCapMid}" Offset="0.35"/>
                    <GradientStop Color="{DynamicResource LampCapEdge}" Offset="0.9"/>
                  </RadialGradientBrush>
                </Border.Background>
              </Border>

              <!-- specular sheen along the cap top -->
              <Border x:Name="sheen" Width="15" Height="3" CornerRadius="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,3,0,0" Background="{DynamicResource SwitchSheen}"/>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <!-- cap snaps across with a slight mechanical overshoot -->
                    <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="25" Duration="0:0:0.15">
                      <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- bulb warm-up: quick rise settling to full -->
                    <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- light takes a moment to bleed through the thick cap -->
                    <DoubleAnimation Storyboard.TargetName="capBleed" Storyboard.TargetProperty="Opacity" To="0.5" BeginTime="0:0:0.04" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="occlude" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                      <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- bulb cool-down: fast initial drop, long dim tail (filament) -->
                    <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.34">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="capBleed" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetName="occlude" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
