<Window x:Class="CUETools.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CUETools 2026" Height="760" Width="1200" MinWidth="640" MinHeight="480"
        Background="{DynamicResource Ground}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <CollectionViewSource x:Key="NavPages" Source="{Binding Pages}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Group"/>
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>

    <!-- SLICE-013 port (D-074/075/076): the rail's two faces. Full cards above
         1140 logical pixels of window width; the icon strip below. Shared
         breakpoints and glyph data live in App.Core; the strip key visual is
         the owner-approved sheet (cuetools-linux docs/evidence). -->
    <local:RailIconConverter x:Key="RailIcon" xmlns:local="clr-namespace:CUETools.Wpf.Controls"/>

    <DataTemplate x:Key="FullNavTemplate">
      <TextBlock Text="{Binding Title}" FontSize="13"/>
    </DataTemplate>

    <DataTemplate x:Key="StripNavTemplate">
      <Border Width="44" Height="38" CornerRadius="7" BorderThickness="1"
              Background="{DynamicResource ButtonFace}" BorderBrush="{DynamicResource ButtonEdge}"
              ToolTip="{Binding Title}">
        <Path Data="{Binding Title, Converter={StaticResource RailIcon}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Width="24" Height="24" Stretch="None"
              HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path.Style>
            <Style TargetType="Path">
              <Setter Property="Stroke" Value="{DynamicResource StripEtched}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter Property="Stroke" Value="{DynamicResource StripLit}"/>
                  <Setter Property="Effect">
                    <Setter.Value>
                      <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.8"
                                        Color="{DynamicResource StripGlowColor}"/>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Path.Style>
        </Path>
      </Border>
    </DataTemplate>

    <Style x:Key="StripNavItem" TargetType="ListBoxItem">
      <!-- Left, not Center: the rail's scrollbar appears and disappears with window height, and a
           centred icon jumps about 8px when it does. -->
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="FullGroupHeader">
      <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="Bold"
                 Foreground="{DynamicResource Muted}" Margin="11,13,0,4"/>
    </DataTemplate>
    <DataTemplate x:Key="StripGroupHeader">
      <Border Height="10"/>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- faceplate -->
    <Border Grid.Row="0" Background="{DynamicResource Face}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
      <DockPanel LastChildFill="False">
        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource Teal}" VerticalAlignment="Center" Margin="0,0,11,0"/>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock FontFamily="{StaticResource Serif}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Ink}">
            CUE<Run Foreground="{StaticResource Teal}">Tools</Run>
          </TextBlock>
          <TextBlock FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{DynamicResource Muted}" Text="2026 - rip - verify - repair - convert"/>
        </StackPanel>
        <!-- theme toggle (rightmost) -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <TextBlock Text="LIGHT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,9,0"/>
          <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontFamily="{StaticResource Mono}" FontSize="11"
                   Foreground="{DynamicResource InkDim}" Text="{Binding DriveStatus}"/>
      </DockPanel>
    </Border>

    <!-- body: nav + content -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="RailColumn" Width="214"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <ListBox x:Name="NavList" ItemsSource="{Binding Source={StaticResource NavPages}}"
                 SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Padding="8,8"
                 ItemTemplate="{StaticResource FullNavTemplate}"
                 ItemContainerStyle="{StaticResource NavItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.GroupStyle>
            <GroupStyle HeaderTemplate="{StaticResource FullGroupHeader}"/>
          </ListBox.GroupStyle>
        </ListBox>
      </Border>

      <ScrollViewer Grid.Column="1" x:Name="PageScroll"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" ContentTemplateSelector="{StaticResource PageSelector}"/>
      </ScrollViewer>
    </Grid>

    <!-- theme-transition overlay: covers the whole window and fades on toggle so the interface
         "turns on" (warm-up) going light and "turns off" (cool-down) going dark. Not hit-testable. -->
    <Border x:Name="ThemeFlash" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0"/>
  </Grid>
</Window>
