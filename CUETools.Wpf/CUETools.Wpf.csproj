<Project Sdk="Microsoft.NET.Sdk">

  <!-- CUETools 2026 - the unified WPF/.NET 8 front end (R12). Drives the existing engine
       (Processor et al. via netstandard2.0; Ripper.SCSI via net8.0-windows) through the
       CUESheet facade: rip, verify and repair, convert, drive readout, and settings. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CUETools.Wpf</RootNamespace>
    <AssemblyName>CUETools.Wpf</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- release identity: version scheme is year.release (matches the "CUETools 2026" branding) -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>2026.1.0</Version>
    <FileVersion>2026.1.0.0</FileVersion>
    <Product>CUETools 2026</Product>
    <Company>CUETools contributors</Company>
    <Description>CD ripping, verification, and repair - AccurateRip and CUETools DB</Description>
    <Copyright>(C) 2008-2026 Grigory Chudov and CUETools contributors. GPL v3.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- live-icon assets: 8 spin frames for the window/taskbar icon while ripping, plus the
         taskbar overlay badges (amber re-read, red unreadable, green done). app.ico doubles as a
         Resource so the window can restore its crisp multi-size icon after animating. -->
    <Resource Include="Assets\*.png" />
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CUETools.Processor\CUETools.Processor.csproj" />
    <ProjectReference Include="..\CUETools.Codecs\CUETools.Codecs.csproj" />
    <ProjectReference Include="..\CUETools.CDImage\CUETools.CDImage.csproj" />
    <ProjectReference Include="..\CUETools.AccurateRip\CUETools.AccurateRip.csproj" />
    <ProjectReference Include="..\CUETools.CTDB\CUETools.CTDB.csproj" />
    <ProjectReference Include="..\CUETools.CTDB.Types\CUETools.CTDB.Types.csproj" />
    <ProjectReference Include="..\CUETools.Compression\CUETools.Compression.csproj" />
    <ProjectReference Include="..\CUETools.Parity\CUETools.Parity.csproj" />
    <ProjectReference Include="..\CUETools.Ripper\CUETools.Ripper.csproj" />
    <ProjectReference Include="..\CUETools.Ripper.SCSI\CUETools.Ripper.SCSI.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.Flake\CUETools.Codecs.Flake.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.ALAC\CUETools.Codecs.ALAC.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.libmp3lame\CUETools.Codecs.libmp3lame.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.WMA\CUETools.Codecs.WMA.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.HDCD\CUETools.Codecs.HDCD.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.libFLAC\CUETools.Codecs.libFLAC.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.libwavpack\CUETools.Codecs.libwavpack.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.MACLib\CUETools.Codecs.MACLib.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.MPEG\CUETools.Codecs.MPEG.csproj" />
    <ProjectReference Include="..\Freedb\Freedb.csproj" />
  </ItemGroup>

  <!-- This is the exact packaged managed-plugin allowlist. Copy and manifest generation consume
       the same item set so a new plugin cannot be shipped without being hash-bound at runtime. -->
  <ItemGroup>
    <ManagedCodecPlugin Include="CUETools.Codecs.Flake.dll" />
    <ManagedCodecPlugin Include="CUETools.Codecs.ALAC.dll" />
    <ManagedCodecPlugin Include="CUETools.Codecs.libmp3lame.dll" />
    <ManagedCodecPlugin Include="CUETools.Codecs.WMA.dll" />
    <ManagedCodecPlugin Include="CUETools.Codecs.HDCD.dll" />
    <ManagedCodecPlugin Include="CUETools.Codecs.libFLAC.dll" />
    <ManagedCodecPlugin Include="CUETools.Codecs.libwavpack.dll" />
    <ManagedCodecPlugin Include="CUETools.Codecs.MACLib.dll" />
    <ManagedCodecPlugin Include="CUETools.Codecs.MPEG.dll" />

    <!-- hdcd.dll and libmp3lame.dll are tracked legacy x64 runtimes. The other three DLLs are
         reproducible build outputs from pinned, patched source inputs, not checked-in binaries.
         CI and release builds must provide every dependency before this project runs; a missing
         dependency is a hard build failure, never a conditionally omitted codec. -->
    <NativeCodecPlugin Include="..\ThirdParty\x64\hdcd.dll" />
    <NativeCodecPlugin Include="..\ThirdParty\x64\libFLAC_dynamic.dll" />
    <NativeCodecPlugin Include="..\ThirdParty\x64\libmp3lame.dll" />
    <NativeCodecPlugin Include="..\ThirdParty\x64\wavpackdll.dll" />
    <NativeCodecPlugin Include="..\ThirdParty\x64\MACLibDll.dll" />
  </ItemGroup>

  <!-- Optional command encoders are prepared from hash-pinned upstream archives. They live in a
       separate package folder and are lower precedence than a hash-bound per-user import. A normal
       developer build may omit them; the release orchestrator prepares them and the artifact
       contract requires their exact bytes. -->
  <ItemGroup>
    <ExternalCommandEncoder
      Include="..\ThirdParty\encoders\x64\opusenc.exe"
      Condition="Exists('..\ThirdParty\encoders\x64\opusenc.exe')" />
    <ExternalCommandEncoder
      Include="..\ThirdParty\encoders\x64\oggenc2.exe"
      Condition="Exists('..\ThirdParty\encoders\x64\oggenc2.exe')" />
    <ExternalCommandSource
      Include="..\ThirdParty\encoders\source\oggenc2.88srcs.zip"
      Condition="Exists('..\ThirdParty\encoders\source\oggenc2.88srcs.zip')" />
  </ItemGroup>

  <!-- The engine discovers codec plugins from a "plugins" subdir; put the managed codecs there
       so ripping/converting use them (no external exe needed). Loaded via Assembly.LoadFrom
       after the generated hash allowlist approves the exact bytes. Unmanifested plugins are
       available only through the explicit local-development environment switch documented by
       PluginTrustManifest. Flake = FLAC, ALAC = m4a.
       NOTE: publish must stay folder-based (no single-file): the engine locates plugins\ from
       Assembly.Location, which is empty under single-file extraction. -->
  <Target Name="CopyManagedPlugins" AfterTargets="Build">
    <ItemGroup>
      <_BuiltManagedPlugin Include="@(ManagedCodecPlugin->'$(TargetDir)%(Filename)%(Extension)')" />
      <_ExistingBuiltPlugin Include="$(TargetDir)plugins\*.dll" />
      <_ExistingBuiltPlugin Include="$(TargetDir)plugins\mono\*.dll" />
      <_ExistingBuiltPlugin Include="$(TargetDir)plugins\win32\*.dll" />
      <_ExistingBuiltPlugin Include="$(TargetDir)plugins\x64\*.dll" />
    </ItemGroup>
    <Error
      Condition="!Exists('%(NativeCodecPlugin.FullPath)')"
      Text="Required x64 codec dependency is missing: %(NativeCodecPlugin.Identity). Reproduce the pinned native codec outputs before building CUETools.Wpf." />
    <Delete Files="@(_ExistingBuiltPlugin)" />
    <Delete Files="$(TargetDir)libmp3lame.dll" />
    <Copy SourceFiles="@(_BuiltManagedPlugin)" DestinationFolder="$(TargetDir)plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeCodecPlugin)" DestinationFolder="$(TargetDir)plugins\x64" SkipUnchangedFiles="true" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\Write-PluginManifest.ps1&quot; -PluginDirectory &quot;$(TargetDir)plugins&quot;" />
  </Target>
  <Target Name="PublishManagedPlugins" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedManagedPlugin Include="@(ManagedCodecPlugin->'$(PublishDir)%(Filename)%(Extension)')" />
      <_ExistingPublishedPlugin Include="$(PublishDir)plugins\*.dll" />
      <_ExistingPublishedPlugin Include="$(PublishDir)plugins\mono\*.dll" />
      <_ExistingPublishedPlugin Include="$(PublishDir)plugins\win32\*.dll" />
      <_ExistingPublishedPlugin Include="$(PublishDir)plugins\x64\*.dll" />
    </ItemGroup>
    <Error
      Condition="!Exists('%(NativeCodecPlugin.FullPath)')"
      Text="Required x64 codec dependency is missing: %(NativeCodecPlugin.Identity). Reproduce the pinned native codec outputs before publishing CUETools.Wpf." />
    <Delete Files="@(_ExistingPublishedPlugin)" />
    <Delete Files="$(PublishDir)libmp3lame.dll" />
    <Copy SourceFiles="@(_PublishedManagedPlugin)" DestinationFolder="$(PublishDir)plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeCodecPlugin)" DestinationFolder="$(PublishDir)plugins\x64" SkipUnchangedFiles="true" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\Write-PluginManifest.ps1&quot; -PluginDirectory &quot;$(PublishDir)plugins&quot;" />
  </Target>

  <Target Name="CopyExternalCommandEncoders" AfterTargets="Build">
    <Delete Files="$(TargetDir)encoders\opusenc.exe;$(TargetDir)encoders\oggenc2.exe;$(TargetDir)encoders\source\oggenc2.88srcs.zip" />
    <Copy
      SourceFiles="@(ExternalCommandEncoder)"
      DestinationFolder="$(TargetDir)encoders"
      SkipUnchangedFiles="true"
      Condition="'@(ExternalCommandEncoder)' != ''" />
    <Copy
      SourceFiles="@(ExternalCommandSource)"
      DestinationFolder="$(TargetDir)encoders\source"
      SkipUnchangedFiles="true"
      Condition="'@(ExternalCommandSource)' != ''" />
  </Target>

  <Target Name="PublishExternalCommandEncoders" AfterTargets="Publish">
    <Delete Files="$(PublishDir)encoders\opusenc.exe;$(PublishDir)encoders\oggenc2.exe;$(PublishDir)encoders\source\oggenc2.88srcs.zip" />
    <Copy
      SourceFiles="@(ExternalCommandEncoder)"
      DestinationFolder="$(PublishDir)encoders"
      SkipUnchangedFiles="true"
      Condition="'@(ExternalCommandEncoder)' != ''" />
    <Copy
      SourceFiles="@(ExternalCommandSource)"
      DestinationFolder="$(PublishDir)encoders\source"
      SkipUnchangedFiles="true"
      Condition="'@(ExternalCommandSource)' != ''" />
  </Target>

</Project>
