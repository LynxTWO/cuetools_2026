{
  "schema_version": 1,
  "execution_policy": {
    "owner_confirmed_safe_to_execute": true,
    "notes": "Reviewed 2026-08-08. These gates invoke existing repository-owned validation scripts or the checked CI fuzz command. They do not sign, publish, contact optical hardware, install dependencies, or mutate vendor submodules. The user explicitly authorized the needed tests."
  },
  "machine": {
    "notes": [
      "Windows workstation with .NET 8 and Visual Studio 2022 toolchains.",
      "Use pwsh for Python-launched local gates. A nested Windows PowerShell 5.1 process inherits PowerShell 7's PSModulePath and can resolve the incompatible Microsoft.PowerShell.Utility module; hosted cmd lanes retain the real Windows PowerShell 5.1 coverage.",
      "Optical-drive, signing, and publication checks remain manual or hosted boundaries and are not default local gates."
    ],
    "avoid_locally": [
      "credentialed signing or publication",
      "unattended optical-drive recovery tests",
      "full classic release orchestration unless explicitly requested"
    ],
    "preferred_remote_runner": "windows-2022 for classic multi-architecture and release evidence"
  },
  "gates": [
    {
      "id": "01-release-safety-contracts",
      "level": 0,
      "argv": [
        "pwsh",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "eng/release/Test-ReleaseSafety.ps1"
      ],
      "enabled": true,
      "source": "eng/release/Test-ReleaseSafety.ps1",
      "source_definition_sha256": "e874225ba0f1cec079610881d2a66d6c7498d654ba2aca98fc8f3a08e90ccfdc",
      "confidence": "verified",
      "timeout_seconds": 600,
      "resource_class": "medium",
      "cwd": ".",
      "include_globs": [
        "eng/ci/**",
        "eng/release/**",
        ".github/workflows/**",
        "Directory.*",
        "**/*.csproj",
        "**/packages.lock.json"
      ],
      "exclude_globs": [
        ".agents/skills/**",
        ".claude/skills/**",
        ".anti-dark-code/**"
      ],
      "review_status": "approved",
      "owner_notes": "Repository-owned contract suite. It validates release policy and helper behavior without creating or publishing a release."
    },
    {
