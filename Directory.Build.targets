<Project>

  <!--
    Build modernization (decision D7 / remediation R8): let first-party desktop projects that
    hold binary .resx resources build under the .NET SDK (`dotnet build`), not only full Visual
    Studio / devenv. Core MSBuild's GenerateResource cannot serialize non-string resources
    without the preserialized path plus System.Resources.Extensions (errors MSB3822/MSB3823).

    GenerateResourceUsePreserializedResources remains gated on
    $(MSBuildRuntimeType) == 'Core' ON PURPOSE: it applies ONLY to `dotnet build`.
    Full MSBuild (devenv / the CI + release workflows that produce shipping binaries)
    sees the same package identities during restore so one reviewed lock file describes
    both hosts, but ExcludeAssets=all keeps them out of compilation, app config, and
    publication. The classic full-framework resgen therefore retains its resource format
    and runtime closure.

    Further scope:
      - net47 only. net20 cannot consume System.Resources.Extensions.
      - ThirdParty excluded by path (taglib-sharp already has its own Directory.Build.* and is
        excluded automatically; this covers the rest).
      - C++ (.vcxproj) and the .vdproj installer never set these TFM properties.
      - SDK command hosts without resources may set CUEToolsDisableCoreResxExtension=true so
        an unrelated resource package and binding redirect do not enter their runtime closure.

    Limitation: old-style (non-SDK) csproj do not restore a PackageReference injected here.
    FLACCL's paired plugin/command projects were converted under R12/R88, BluTools
    became the first classic GUI pilot under R90, CUERipper plus its
    ProgressODoom control dependency followed under R91, CUEPlayer followed
    under R92, and CUETools completed the classic GUI set under R93. The
    disabled, non-building CLParity experiment was retired under R89. SDK-style
    first-party net47 projects build under `dotnet build` with this in place.
    The resource-free CUETools.TestHelpers project is SDK-style but opts out
    explicitly so every restore host sees the same test dependency graph.

    Core MSBuild also adds Microsoft.NETFramework.ReferenceAssemblies when it targets
    net20 on a machine without that targeting pack. Full MSBuild has the targeting pack,
    but still declares the package as restore-only so locked restore sees the same graph.
  -->

  <PropertyGroup>
    <_AdcNet47ResxEligible Condition="'$(CUEToolsDisableCoreResxExtension)' != 'true' And '$(TargetFramework)' == 'net47' And !$(MSBuildProjectDirectory.Contains('ThirdParty'))">true</_AdcNet47ResxEligible>
    <_AdcCoreNet47Resx Condition="'$(_AdcNet47ResxEligible)' == 'true' And '$(MSBuildRuntimeType)' == 'Core'">true</_AdcCoreNet47Resx>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_AdcCoreNet47Resx)' == 'true'">
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup Condition="'$(_AdcCoreNet47Resx)' == 'true'">
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(_AdcNet47ResxEligible)' == 'true' And '$(MSBuildRuntimeType)' != 'Core'">
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0"
                      ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net20' And '$(MSBuildRuntimeType)' != 'Core' And !$(MSBuildProjectDirectory.Contains('ThirdParty'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3"
                      ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Some retained old-style projects name Visual Studio's installed AllRules.ruleset.
    Core MSBuild does not search that Visual Studio ruleset directory, so the
    setting cannot take effect there and only emits MSB3884. Preserve the rule
    selection for full Visual Studio builds and clear the unresolved Core value.
  -->
  <PropertyGroup Condition="'$(MSBuildRuntimeType)' == 'Core' And '$(CodeAnalysisRuleSet)' == 'AllRules.ruleset' And !Exists('$(MSBuildProjectDirectory)\AllRules.ruleset')">
    <CodeAnalysisRuleSet />
  </PropertyGroup>

  <!--
    The pinned OpenCLNet gitlink deliberately retains OpenCL 1.1 fallback calls for old devices,
    and its unused DirectX 9 extension carries an upstream #warning. Keep those compatibility
    decisions visible here without editing or dirtying the immutable vendor source.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OpenCLNet'">
    <NoWarn>$(NoWarn);CS0618;CS1030</NoWarn>
  </PropertyGroup>

</Project>
