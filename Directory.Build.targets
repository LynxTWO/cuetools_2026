<Project>

  <!--
    Build modernization (decision D7 / remediation R8): let first-party desktop projects that
    hold binary .resx resources build under the .NET SDK (`dotnet build`), not only full Visual
    Studio / devenv. Core MSBuild's GenerateResource cannot serialize non-string resources
    without the preserialized path plus System.Resources.Extensions (errors MSB3822/MSB3823).

    Gated on $(MSBuildRuntimeType) == 'Core' ON PURPOSE: this applies ONLY to `dotnet build`.
    Under full MSBuild (devenv / the CI + release workflows that produce the shipping binaries)
    this resource block is a complete no-op, so the shipping build's resource format and runtime
    dependencies are provably unchanged. The classic full-framework resgen keeps handling binary
    resources there with no extra runtime DLL. This keeps the local-dev affordance from leaking
    into what users download.

    Further scope:
      - net47 only. net20 cannot consume System.Resources.Extensions.
      - ThirdParty excluded by path (taglib-sharp already has its own Directory.Build.* and is
        excluded automatically; this covers the rest).
      - C++ (.vcxproj) and the .vdproj installer never set these TFM properties.
      - SDK command hosts without resources may set CUEToolsDisableCoreResxExtension=true so
        an unrelated resource package and binding redirect do not enter their runtime closure.

    Limitation: old-style (non-SDK) csproj do not restore a PackageReference injected here.
    FLACCL's paired plugin/command projects were converted under R12/R88, BluTools
    became the first classic GUI pilot under R90, CUERipper plus its
    ProgressODoom control dependency followed under R91, and CUEPlayer followed
    under R92. Only the old-style CUETools GUI still needs SDK conversion and
    runtime UI verification. The
    disabled, non-building CLParity experiment was retired under R89. SDK-style
    first-party net47 projects build under `dotnet build` with this in place.

    A Core restore intentionally includes System.Resources.Extensions. A shipping
    full-MSBuild build must perform its canonical full-MSBuild restore first;
    reusing Core's project.assets.json can otherwise make the conditional package
    appear in the generated app config even though this target is a Full no-op.
  -->

  <PropertyGroup>
    <_AdcCoreNet47Resx Condition="'$(CUEToolsDisableCoreResxExtension)' != 'true' And '$(MSBuildRuntimeType)' == 'Core' And ('$(TargetFramework)' == 'net47' Or ('$(TargetFramework)' == '' And '$(TargetFrameworkVersion)' == 'v4.7')) And !$(MSBuildProjectDirectory.Contains('ThirdParty'))">true</_AdcCoreNet47Resx>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_AdcCoreNet47Resx)' == 'true'">
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup Condition="'$(_AdcCoreNet47Resx)' == 'true'">
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <!--
    Several old-style projects name Visual Studio's installed AllRules.ruleset.
    Core MSBuild does not search that Visual Studio ruleset directory, so the
    setting cannot take effect there and only emits MSB3884. Preserve the rule
    selection for full Visual Studio builds and clear the unresolved Core value.
  -->
  <PropertyGroup Condition="'$(MSBuildRuntimeType)' == 'Core' And '$(CodeAnalysisRuleSet)' == 'AllRules.ruleset' And !Exists('$(MSBuildProjectDirectory)\AllRules.ruleset')">
    <CodeAnalysisRuleSet />
  </PropertyGroup>

  <!--
    The pinned OpenCLNet gitlink deliberately retains OpenCL 1.1 fallback calls for old devices,
    and its unused DirectX 9 extension carries an upstream #warning. Keep those compatibility
    decisions visible here without editing or dirtying the immutable vendor source.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OpenCLNet'">
    <NoWarn>$(NoWarn);CS0618;CS1030</NoWarn>
  </PropertyGroup>

</Project>
