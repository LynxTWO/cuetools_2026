<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral application core extracted from CUETools.Wpf (verify slice).
       ViewModels and services shared by the WPF head and the CUETools Linux head.
       Namespaces intentionally keep their original CUETools.Wpf.* names so both
       heads and the existing test suite consume moved types without source
       changes; renaming is deferred until both heads are stable. No WPF, no
       Windows-only APIs: platform behavior enters through the interfaces in
       Services/Platform. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CUETools.Wpf</RootNamespace>
    <Version>2026.1.0</Version>
    <FileVersion>2026.1.0.0</FileVersion>
    <Product>CUETools 2026</Product>
    <Company>CUETools contributors</Company>
    <Description>Platform-neutral application core for CUETools 2026 front ends</Description>
    <Copyright>(C) 2008-2026 Grigory Chudov and CUETools contributors. GPL v3.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CUETools.Processor\CUETools.Processor.csproj" />
    <ProjectReference Include="..\CUETools.CTDB\CUETools.CTDB.csproj" />
    <!-- Rip slice: the calibration and rip services moved here consume the
         ripper stack directly. Both ripper projects gained a neutral net8.0
         TargetFramework for exactly this consumer. -->
    <ProjectReference Include="..\CUETools.Ripper\CUETools.Ripper.csproj" />
    <ProjectReference Include="..\CUETools.Ripper.SCSI\CUETools.Ripper.SCSI.csproj" />
    <!-- The output-verification evaluator keeps exact compile-time type
         identity for every codec with a platform-neutral flavor. WMA is
         Windows-only and joins through the typed verify-on-encode seam
         behind a name-identity gate instead (see
         OutputVerificationAssurance.cs). -->
    <ProjectReference Include="..\CUETools.Codecs.Flake\CUETools.Codecs.Flake.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.ALAC\CUETools.Codecs.ALAC.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.libFLAC\CUETools.Codecs.libFLAC.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.libwavpack\CUETools.Codecs.libwavpack.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.MACLib\CUETools.Codecs.MACLib.csproj" />
  </ItemGroup>

</Project>
