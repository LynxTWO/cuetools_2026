<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RunCtdbLiveProbe)' == 'true'">
    <!-- Opt-in only: this test contacts CTDB, consumes a known damaged lossless image, and
         publishes a repaired sibling. It is deliberately absent from ordinary discovery. -->
    <DefineConstants>$(DefineConstants);CTDB_LIVE_PROBE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RunOpticalTestCopyProbe)' == 'true'">
    <!-- Opt-in only: this test calibrates a real drive, reads a loaded audio CD at least twice,
         and temporarily publishes a verified FLAC album under a caller-owned unique root. -->
    <DefineConstants>$(DefineConstants);OPTICAL_TESTCOPY_LIVE_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CUETools.Wpf\CUETools.Wpf.csproj" />
    <ProjectReference
      Include="..\CUETools.Codecs.Flake\CUETools.Codecs.Flake.csproj"
      SetTargetFramework="TargetFramework=netstandard2.0" />
    <ProjectReference Include="..\CUETools.Codecs.Icecast\CUETools.Codecs.Icecast.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.HDCD\CUETools.Codecs.HDCD.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.libFLAC\CUETools.Codecs.libFLAC.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.libwavpack\CUETools.Codecs.libwavpack.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.MACLib\CUETools.Codecs.MACLib.csproj" />
    <ProjectReference Include="..\CUETools.Codecs.MPEG\CUETools.Codecs.MPEG.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Native wrappers resolve dependencies relative to their managed assembly. Keep the test
         layout identical to the production plugins\x64 contract so net8 exercises the real loader. -->
    <None Include="..\ThirdParty\x64\hdcd.dll" Link="x64\hdcd.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ThirdParty\x64\libFLAC_dynamic.dll" Link="x64\libFLAC_dynamic.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ThirdParty\x64\libmp3lame.dll" Link="x64\libmp3lame.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ThirdParty\x64\wavpackdll.dll" Link="x64\wavpackdll.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ThirdParty\x64\MACLibDll.dll" Link="x64\MACLibDll.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
